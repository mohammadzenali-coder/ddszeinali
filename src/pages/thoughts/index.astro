---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { faDate } from '../../site';
const posts = (await getCollection('thoughts')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="یادداشت‌ها درباره‌ی دندانپزشکی زیبایی" description="یادداشت‌های دکتر محمد رضا زینلی درباره‌ی زیبایی‌شناسی لبخند، لاکچری در دندانپزشکی زیبایی و فلسفه‌ی درمان."
  breadcrumbs={[{ name: 'یادداشت‌ها', url: '/thoughts/' }]}>
  <PageHead kicker="نوشته‌ها" title="یادداشت‌ها" lead="درباره‌ی زیبایی‌شناسی، تناسب، و آنچه یک لبخند را ماندگار می‌کند." color="red" />
  <section class="section">
    <div class="wrap">
      <ol class="list">
        {posts.map((p) => (
          <li class="card">
            <time class="label muted" datetime={p.data.date.toISOString()}>{faDate(p.data.date)}</time>
            <h2 class="h-sm"><a href={`/thoughts/${p.id}/`}>{p.data.title}</a></h2>
            <p class="muted">{p.data.description}</p>
            <div>{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--md); max-width: 820px; }
  .list h2 a { text-decoration: none; }
  .list h2 a::after { content: ''; position: absolute; inset: 0; }
  .list li { position: relative; }
  .list li:hover { border-inline-start: 12px solid var(--red); }
  .list p { margin: var(--xs) 0 var(--sm); }
  .tag { margin-inline-end: 6px; }
</style>
