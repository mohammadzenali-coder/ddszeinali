---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { getCollection } from 'astro:content';
import { SITE, SERVICES, faNum, faDate } from '../site';

const cases = (await getCollection('portfolio')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const posts = (await getCollection('thoughts')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const shape = { red: 'sq', blue: 'tr', yellow: 'ci' } as const;
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__txt">
        <p class="label hero__kicker"><i class="sq" style="--s:12px"></i> دندانپزشکی زیبایی</p>
        <h1 class="h-xl">دکتر<br />محمد رضا<br />زینلی</h1>
        <p class="hero__lead">فرم از عملکرد پیروی می‌کند. لبخندی که طراحی می‌کنم باید پیش از زیبا بودن، <strong>درست</strong> باشد.</p>
        <div class="hero__cta">
          <a class="btn" href="/portfolio/">دیدن نمونه‌کارها</a>
          <a class="btn btn--ghost" href="/contact/">تماس و مشاوره</a>
        </div>
      </div>
      <div class="hero__comp" aria-hidden="true">
        <div class="b b1"></div><div class="b b2"></div><div class="b b3"></div><div class="b b4"></div>
        <span class="b5 en">Form Follows Function</span>
      </div>
    </div>
  </section>

  <!-- SERVICES STRIP -->
  <section class="strip" aria-label="خدمات">
    <ul class="wrap strip__list">
      {SERVICES.map((s) => (
        <li><a href={`/services/${s.slug}/`}><i class={shape[s.color]} style="--s:14px"></i>{s.title}</a></li>
      ))}
    </ul>
  </section>

  <!-- ABOUT -->
  <section class="section">
    <div class="wrap about">
      <div class="sec-head"><span class="label">۰۱</span><h2 class="h-lg">درباره‌ی من</h2></div>
      <div class="about__body">
        <p class="h-sm">دندانپزشکی زیبایی برای من یک مهارت فنی نیست؛ یک زبان طراحی است.</p>
        <p class="muted">من محمد رضا زینلی هستم، دندانپزشک. تمرکز کارم روی کامپوزیت ونیر، طراحی دیجیتال لبخند و زیبایی لبخند است. در هر درمان، تناسب صورت، رنگ طبیعی و دوام را بر هر جلوه‌ی زودگذری مقدم می‌دانم.</p>
        <a class="btn btn--ghost" href="/about/">بیشتر بخوانید</a>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head"><span class="label">۰۲</span><h2 class="h-lg">نمونه‌کارها</h2></div>
      <div class="grid g-3">
        {cases.map((c, i) => (
          <a class="card pcard" href={`/portfolio/${c.id}/`}>
            <Art v={c.data.art} label={c.data.title} />
            <span class="pcard__n">{faNum(String(i + 1).padStart(2, '0'))}</span>
            <h3 class="h-sm">{c.data.title}</h3>
            <p class="muted">{c.data.description}</p>
            <span class="tag">{c.data.service}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- THOUGHTS -->
  <section class="section thoughts">
    <div class="wrap">
      <div class="sec-head"><span class="label">۰۳</span><h2 class="h-lg">یادداشت‌ها</h2></div>
      <ol class="tlist">
        {posts.map((p) => (
          <li>
            <a href={`/thoughts/${p.id}/`}>
              <time class="label muted" datetime={p.data.date.toISOString()}>{faDate(p.data.date)}</time>
              <span class="h-sm">{p.data.title}</span>
              <span class="arrow" aria-hidden="true">←</span>
            </a>
          </li>
        ))}
      </ol>
      <a class="btn btn--ghost" href="/thoughts/">همه‌ی یادداشت‌ها</a>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="cta">
    <div class="wrap cta__grid">
      <h2 class="h-xl">بیایید<br />لبخندتان را<br />بسازیم.</h2>
      <div>
        <p>برای مشاوره و نوبت‌دهی پیام بدهید.</p>
        <a class="btn cta__btn" href="/contact/">راه‌های تماس</a>
        <p class="label cta__mail"><a href={`mailto:${SITE.email}`} class="en">{SITE.email}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { border-bottom: var(--b3) solid var(--border); }
  .hero__grid { display: grid; gap: var(--lg); padding-block: var(--lg); }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 7fr 5fr; align-items: stretch; padding-block: 96px; } }
  .hero__kicker { display: inline-flex; align-items: center; gap: var(--xs); border: var(--b2) solid var(--border); padding: 4px 12px; background: var(--surface); margin-bottom: var(--md); }
  .hero__lead { font-size: 19px; max-width: 34ch; margin-top: var(--md); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--sm); margin-top: var(--md); }

  .hero__comp { position: relative; min-height: 360px; display: grid; grid-template: 1fr 1fr / 1fr 1fr; border: var(--b3) solid var(--border); background: var(--surface); }
  .b1 { background: var(--blue); grid-row: 1 / 3; }
  .b2 { background: var(--yellow); border-radius: 50%; margin: 18%; align-self: center; aspect-ratio: 1; grid-area: 1 / 2; }
  .b3 { background: var(--red); grid-area: 2 / 2; border-top: var(--b3) solid var(--border); border-inline-end: var(--b3) solid var(--border); }
  .b4 { position: absolute; width: 38%; aspect-ratio: 1; background: var(--text); clip-path: polygon(50% 0, 100% 100%, 0 100%); bottom: 0; inset-inline-end: 31%; }
  .b5 { position: absolute; top: var(--sm); inset-inline-end: var(--sm); writing-mode: vertical-rl; font-weight: 800; font-size: 13px; color: #fff; }

  .strip { background: var(--text); color: #fff; border-bottom: var(--b3) solid var(--border); }
  .strip__list { list-style: none; margin: 0; display: flex; flex-wrap: wrap; }
  .strip__list li { flex: 1 1 50%; }
  @media (min-width: 720px) { .strip__list li { flex: 1; } }
  .strip__list a { display: flex; align-items: center; gap: 10px; padding: var(--sm) var(--sm); text-decoration: none; font-weight: 700; }
  .strip__list a:hover { background: #fff; color: var(--text); }

  @media (min-width: 900px) { .about { display: grid; grid-template-columns: 5fr 7fr; gap: var(--lg); } .about .sec-head { align-items: flex-start; } }

  .pcard { display: flex; flex-direction: column; gap: var(--sm); text-decoration: none; position: relative; }
  .pcard p { margin: 0; flex: 1; }
  .pcard__n { position: absolute; top: var(--md); inset-inline-start: var(--md); background: var(--text); color: #fff; font-weight: 800; padding: 2px 10px; }
  .pcard:hover { background: var(--yellow); }
  .pcard .tag { align-self: flex-start; }

  .thoughts { background: var(--surface); }
  .tlist { list-style: none; margin: 0 0 var(--lg); padding: 0; border-top: var(--b2) solid var(--border); }
  .tlist a { display: grid; grid-template-columns: 1fr auto; gap: 4px var(--md); padding: var(--md) 0; border-bottom: var(--b2) solid var(--border); text-decoration: none; }
  .tlist time { grid-column: 1 / -1; }
  .tlist a:hover .h-sm { text-decoration: underline; }
  .arrow { font-size: 24px; font-weight: 800; }
  @media (min-width: 720px) { .tlist a { grid-template-columns: 200px 1fr auto; align-items: center; } .tlist time { grid-column: auto; } }

  .cta { background: var(--red); color: #fff; }
  .cta__grid { display: grid; gap: var(--lg); padding-block: 96px; align-items: end; }
  @media (min-width: 900px) { .cta__grid { grid-template-columns: 7fr 5fr; } }
  .cta__btn { background: #fff; color: var(--text); border-color: #fff; }
  .cta__btn:hover { background: var(--text); color: #fff; border-color: var(--text); }
  .cta__mail { margin-top: var(--md); }
</style>
