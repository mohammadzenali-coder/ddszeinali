---
// ترکیب هندسی باهاوس — جایگزین موقت تصاویر تا آماده شدن عکس‌های واقعی
interface Props { v?: number; label?: string }
const { v = 0, label = '' } = Astro.props;
const R = '#CC3333', Y = '#F4C430', B = '#1C39BB', K = '#111111', W = '#FFFFFF';
const compositions = [
  // 0 — circle over split field
  `<rect width="400" height="300" fill="${W}"/><rect width="200" height="300" fill="${B}"/><circle cx="200" cy="150" r="90" fill="${Y}"/><rect x="290" y="210" width="110" height="90" fill="${R}"/>`,
  // 1 — stair blocks
  `<rect width="400" height="300" fill="${Y}"/><rect x="0" y="200" width="140" height="100" fill="${K}"/><rect x="140" y="120" width="130" height="180" fill="${R}"/><circle cx="330" cy="80" r="48" fill="${B}"/>`,
  // 2 — triangle and arc
  `<rect width="400" height="300" fill="${W}"/><path d="M0 300 L200 40 L400 300Z" fill="${R}"/><circle cx="320" cy="70" r="40" fill="${Y}"/><rect x="0" y="0" width="70" height="300" fill="${B}"/>`,
  // 3 — half circles (smile)
  `<rect width="400" height="300" fill="${B}"/><path d="M80 120 A120 120 0 0 0 320 120Z" fill="${W}"/><rect x="0" y="250" width="400" height="50" fill="${K}"/><rect x="300" y="20" width="70" height="70" fill="${Y}"/>`,
  // 4 — grid
  `<rect width="400" height="300" fill="${W}"/><rect x="0" y="0" width="200" height="150" fill="${R}"/><rect x="200" y="150" width="200" height="150" fill="${K}"/><circle cx="300" cy="75" r="55" fill="${B}"/><path d="M40 300 L100 190 L160 300Z" fill="${Y}"/>`,
];
const svg = compositions[v % compositions.length];
---
<svg class="art" viewBox="0 0 400 300" role="img" aria-label={label || 'ترکیب هندسی'} preserveAspectRatio="xMidYMid slice" set:html={svg} />
<style>
  .art { width: 100%; aspect-ratio: 4 / 3; border: var(--b2) solid var(--border); background: #fff; }
</style>
