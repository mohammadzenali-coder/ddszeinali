---
interface Props { kicker: string; title: string; lead?: string; color?: 'red' | 'yellow' | 'blue' }
const { kicker, title, lead, color = 'red' } = Astro.props;
---
<section class={`ph ph--${color}`}>
  <div class="wrap ph__grid">
    <div>
      <p class="label ph__k">{kicker}</p>
      <h1 class="h-lg">{title}</h1>
      {lead && <p class="ph__lead">{lead}</p>}
      <slot />
    </div>
    <div class="ph__shape" aria-hidden="true"></div>
  </div>
</section>
<style>
  .ph { border-bottom: var(--b3) solid var(--border); background: var(--surface); }
  .ph__grid { display: grid; grid-template-columns: 1fr auto; gap: var(--lg); padding-block: var(--lg); align-items: end; }
  @media (min-width: 900px) { .ph__grid { padding-block: 80px; } }
  .ph__k { display: inline-block; background: var(--text); color: #fff; padding: 2px 10px; margin-bottom: var(--sm); }
  .ph__lead { font-size: 18px; max-width: 56ch; margin: var(--sm) 0 0; color: var(--text-2); }
  .ph__shape { width: clamp(64px, 14vw, 160px); aspect-ratio: 1; border: var(--b3) solid var(--border); }
  .ph--red .ph__shape { background: var(--red); }
  .ph--yellow .ph__shape { background: var(--yellow); border-radius: 50%; }
  .ph--blue .ph__shape { background: var(--blue); clip-path: polygon(50% 0, 100% 100%, 0 100%); border: 0; }
</style>
